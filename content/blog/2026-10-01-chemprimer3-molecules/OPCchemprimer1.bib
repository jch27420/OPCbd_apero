	title = {Development of the concept of absolute zero temperature},
	volume = {16},
	copyright = {Educación Química por Universidad Nacional Autónoma de México se distribuye bajo una Licencia Creative Commons Atribución-NoComercial-SinDerivar 4.0 Internacional . Basada en una obra en http://www.revistas.unam.mx/index.php/req .},
