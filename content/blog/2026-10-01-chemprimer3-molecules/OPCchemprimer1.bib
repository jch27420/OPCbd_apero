	doi = {10.1093/mnras/221.4.1023},
	abstract = {Whereas the 1964 IAU standard values of the constants \$R\_0=10{\textbackslash}enspace {\textbackslash}text\{kpc\},{\textbackslash}enspace {\textbackslash}theta\_0=250{\textbackslash}enspace{\textbackslash}text \{km\}{\textbackslash}enspace {\textbackslash}text s{\textasciicircum}\{-1\},{\textbackslash}enspace A=15{\textbackslash}enspace {\textbackslash}text \{km\}{\textbackslash}enspace {\textbackslash}text s{\textasciicircum}\{-1\}{\textbackslash}enspace {\textbackslash}text \{kpc\}{\textasciicircum}\{-1\}, {\textbackslash}enspace {\textbackslash}text \{and\}{\textbackslash}enspace B=-10{\textbackslash}enspace {\textbackslash}text \{km\}{\textbackslash}enspace {\textbackslash}text s{\textasciicircum}\{-1\}{\textbackslash}enspace {\textbackslash}text \{kpc\}{\textasciicircum}\{-1\}\$, differ from those currently considered best, the errors of current determinations are still rather large. Although the means of recent determinations lead to a fairly consistent set of values for the four main constants, the agreement may be largely coincidental. However, a case can be made for agreeing on the pair of standard values \$R\_0=8.5{\textbackslash}enspace {\textbackslash}text \{kpc\} {\textbackslash}enspace {\textbackslash}text \{and\}{\textbackslash}enspace {\textbackslash}theta\_0=220{\textbackslash}enspace {\textbackslash}text \{km\}{\textbackslash}enspace {\textbackslash}text s{\textasciicircum}\{-1\}\$. On the basis of this review these were adopted by resolution of IAU Commission 33 on 1985 November 21 at Delhi.},
