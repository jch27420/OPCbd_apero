	doi = {10.1038/s41467-020-18670-8},
	abstract = {Lowering of the electron kinetic energy (KE) upon initial encounter of radical fragments has long been cited as the primary origin of the covalent chemical bond based on Ruedenberg’s pioneering analysis of H{\textbackslash}documentclass[12pt]\{minimal\}
