@article{cherkasov_concept_1998,
	title = {The concept of electronegativity. {The} current state of the problem},
	volume = {67},
	issn = {1468-4837},
	url = {https://pubs.rsc.org/en/content/articlelanding/1998/rc/rc980375},
	doi = {10.1070/RC1998v067n05ABEH000383},
	abstract = {A systematic account is given of the current ideas about atomic and group electronegativities and the trends in the development of the concept of electronegativity are analysed. Attention is concentrated on the latest A systematic account is given of the current ideas about atomic and group electronegativities and the trends in the development of the concept of electronegativity are analysed. Attention is concentrated on the latest approaches to the definition of electronegativity – the concept of z.ldangorbitalz.rdang electronegativities and the density functional theory. A procedure is proposed for the determination of z.ldanginductivez.rdang electronegativities, which permits a correct theoretical calculation of the electronegativity of a substituent from the electronegativities of individual atoms and the steric structure. It is shown that the approach developed has a series of important advantages – for example, it makes it possible to calculate the group electronegativities of isomeric substituents avoiding the principle of the equalisation of electronegativities. A survey of literature data and generalisation of the method proposed by the authors have made it possible to formulate the concept of electronegativity as an unchanging fundamental immanent characteristic of a chemical element. The bibliography includes 222 references.},
	language = {en},
	number = {5},
