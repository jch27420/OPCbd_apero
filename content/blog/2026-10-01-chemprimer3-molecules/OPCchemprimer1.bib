@article{wang_problem_1928,
	title = {The {Problem} of the {Normal} {Hydrogen} {Molecule} in the {New} {Quantum} {Mechanics}},
	volume = {31},
	url = {https://link.aps.org/doi/10.1103/PhysRev.31.579},
	doi = {10.1103/PhysRev.31.579},
	abstract = {The solution of Schroedinger's equation for the normal hydrogen molecule is approximated by the function 𝐶⁢[𝑒−𝑧⁢(𝑟1+𝑝2)𝑎 +𝑒−𝑧⁢(𝑟2+𝑝1)𝑎] where 𝑎 =ℎ24⁢𝜋2⁢𝑚⁢𝑒2, 𝑟1 and 𝑝1 are the distances of one of the electrons to the two nuclei, and 𝑟2 and 𝑝2 those for the other electron. The value of 𝑍 is so determined as to give a minimum value to the variational integral which generates Schroedinger's wave equation. This minimum value of the integral gives the approximate energy 𝐸. For every nuclear separation 𝐷, there is a 𝑍 which gives the best approximation and a corresponding 𝐸. We thus obtain an approximate energy curve as a function of the separation. The minimum of this curve gives the following data for the configuration corresponding to the normal hydrogen molecule: the heat of dissociation = 3.76 volts, the moment of inertia 𝐽0 =4.59 ×10−41 gr. cm2, the nuclear vibrational frequency 𝜈0 =4900 cm−1.},
	number = {4},
	urldate = {2025-06-04},
	journal = {Physical Review},
	publisher = {American Physical Society},
	author = {Wang, S. C.},
	month = apr,
	year = {1928},
	pages = {579--586},
}

