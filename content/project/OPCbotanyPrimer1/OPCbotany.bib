	keywords = {Homeostasis, Arabidopsis, Arabidopsis Proteins, Chromatin, Transcription Factors, Protein Serine-Threonine Kinases, Plant Stems, Meristem, Genome, Plant, Transcription, Genetic, DNA-Binding Proteins, Gene Expression Regulation, Plant, Homeodomain Proteins, Receptor Protein-Tyrosine Kinases, Genome-Wide Association Study},
	pages = {849--861},
}

