	keywords = {Signal Transduction, Amino Acid Sequence, Molecular Sequence Data, Arabidopsis, Arabidopsis Proteins, Plant Roots, Amino Acid Motifs, Oligopeptides, Cell Differentiation, Stem Cells, Meristem, Cells, Cultured, Plants, Genetically Modified, Hydroxyproline, Spectrometry, Mass, Matrix-Assisted Laser Desorption-Ionization},
