	keywords = {Arabidopsis Proteins, Flowers, Photoperiod, Transcription Factors, Plant Development, DNA-Binding Proteins, Gene Expression Regulation, Plant, Stress, Physiological, CONSTAN, photoperiod, seasonal and environmental cues},
	pages = {425--439},
}

