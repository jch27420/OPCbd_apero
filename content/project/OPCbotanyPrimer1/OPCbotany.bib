	keywords = {Biological Evolution, Amino Acid Sequence, Molecular Sequence Data, Mutation, Plants, Plant Proteins, Arabidopsis, Arabidopsis Proteins, Plant Development, Gene Expression, Meristem, Genes, Plant, Exons},
	pages = {80--83},
}

